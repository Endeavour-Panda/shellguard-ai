# 必须按供应商文档填写完整 API 根地址；不会补猜 /v1 或模型名。
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# auto: 三项全空时模拟，三项齐全时真实调用，部分配置时报错。
# mock: 始终模拟，不访问网络；real: 必须提供完整配置。
SHELLGUARD_BACKEND=auto
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=2500
# 默认仅监听本机；不会创建 Gradio 公网分享链接。
APP_HOST=127.0.0.1
APP_PORT=7860

# local: 本地基础模型 / LoRA 推理；需额外安装 requirements-local.txt。
LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct
# 填写训练产物 final_adapter 的本地目录，留空使用基础模型。
LOCAL_ADAPTER=
# 可选访问口令（管理员账号）；必须同时填写两项。公网部署需另配 HTTPS。
APP_USERNAME=
APP_PASSWORD=
# 启用登录后，登录页会带"注册"入口；自助注册的账号保存在下面这个本地文件里（已在 .gitignore 中）。
USERS_DB_PATH=.runtime/users.json
# 自助注册账号数量上限，防止被脚本刷注册占满磁盘。
MAX_USERS=200
# Docker 发布地址；局域网或公网部署时按需改为 0.0.0.0。
APP_BIND_ADDRESS=127.0.0.1

# Temporary public Gradio link; keep authentication enabled.
APP_SHARE=false
